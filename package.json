{
  "name": "superpdf",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run && playwright test",
    "test:e2e": "playwright test",
    "build:sw": "node scripts/build-sw.mjs",
    "docs:gen": "node scripts/docs-gen.mjs",
    "docs:check": "node scripts/docs-gen.mjs --check",
    "check:sw": "node scripts/check-sw.mjs",
    "check:sendtosw": "node scripts/check-sendtosw.mjs",
    "check": "npm run check:sw && npm run docs:check && npm run check:sendtosw"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "heic2any": "^0.0.4",
    "html2pdf.js": "^0.9.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0",
    "pptxgenjs": "^4.0.1",
    "qpdf-wasm": "^0.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^14.3.8",
    "tesseract.js": "^4.0.2",
    "utif": "^3.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.8",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "sass": "^1.77.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
